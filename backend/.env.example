# ============ DATABASE (Supabase Postgres) ============
# CÁCH 1 (KHUYÊN DÙNG): khai báo rời. Mật khẩu để NGUYÊN VĂN, kể cả có ký tự đặc biệt như % @ # / ? :
#   Lấy ở Supabase > nút "Connect" > Session pooler (hoặc Transaction pooler).
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432                       # 5432 = Session pooler | 6543 = Transaction pooler
DB_NAME=postgres
DB_USER=postgres.<project-ref>     # với pooler, user luôn có dạng postgres.<project-ref>
DB_PASSWORD=<mật-khẩu-database>

# CÁCH 2: một chuỗi URL (mật khẩu PHẢI mã hóa: % -> %25, @ -> %40, # -> %23, / -> %2F, ? -> %3F, : -> %3A)
# Nếu đặt DB_HOST ở trên thì DATABASE_URL bị bỏ qua.
# DATABASE_URL=postgresql://postgres.<ref>:<mật-khẩu-đã-mã-hóa>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Tinh chỉnh pool (mặc định đã phù hợp gói Free; Session pooler chỉ cho ~15 kết nối)
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=240
# DB_CONNECT_TIMEOUT=10
# DB_SSLMODE=require

# ============ BẢO MẬT ============
# Sinh chuỗi ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<chuỗi-ngẫu-nhiên>
JWT_SECRET=<chuỗi-ngẫu-nhiên-khác-dài-hơn-32-ký-tự>

# ============ SERVER ============
FLASK_APP=run.py
FLASK_DEBUG=1                       # chạy thật: 0
# FLASK_HOST=127.0.0.1
# PORT=5000
# CORS_ORIGINS=http://localhost:5173,https://ten-mien-cua-ban.com
# EXPOSE_ERRORS=0                   # 1 = trả chi tiết lỗi nội bộ về client (CHỈ khi phát triển)

# ============ Bảo mật & triển khai thật (xem docs/BAO_MAT.md) ============
# APP_ENV=production                 # khi chạy thật: app TỪ CHỐI khởi động nếu JWT_SECRET/SECRET_KEY yếu (< 32 ký tự / mặc định),
#                                    # EXPOSE_ERRORS=1 hoặc cookie không Secure. Mặc định: development (chỉ cảnh báo).
# FRONTEND_URL=https://app.ten-mien-cua-ban.com   # dùng ghép link trong email "quên mật khẩu"
# TRUSTED_PROXIES=1                  # số proxy đứng trước app (Render/Nginx/Cloudflare = 1). 0 = không tin X-Forwarded-For.
#                                    # Đặt sai thì giới hạn đăng nhập tính theo IP của proxy (mọi người chung 1 IP).
# REFRESH_COOKIE_SECURE=1            # mặc định: bật khi APP_ENV=production (cần HTTPS), tắt khi phát triển
# REFRESH_COOKIE_SAMESITE=Lax        # Lax (mặc định) khi frontend và API cùng site; None nếu khác site hoàn toàn (kèm SECURE=1)
# REFRESH_COOKIE_DOMAIN=             # vd .ten-mien-cua-ban.com nếu app.* và api.* cần dùng chung cookie
# REFRESH_TOKEN_IN_BODY=0            # 1 = trả refresh token trong JSON (chỉ cho script/app di động, KHÔNG dùng cho web)

# ============ AI chấm & sửa câu (STT 17) ============
# Không có khóa nào: trang "Đặt câu" vẫn chạy nhưng chỉ dùng câu mẫu cố định, so khớp đáp án, KHÔNG có điểm
# (và hiển thị thông báo rõ ràng cho người học).
# AI_PROVIDER=auto                       # auto (mặc định: có GEMINI_API_KEY thì dùng Gemini, không thì Claude) | gemini | anthropic
#
# --- Gemini (có gói miễn phí) - lấy khóa ở https://aistudio.google.com -> Get API key ---
# Đừng gắn tài khoản thanh toán vào project của khóa này nếu muốn giữ miễn phí.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-flash-lite-latest  # bí danh "latest" tự trỏ tới Flash-Lite mới nhất; chấm kỹ hơn: gemini-flash-latest
# GEMINI_RPM=10                          # trần số lượt/phút cho CẢ server (hạn mức free là của cả project); mỗi worker đếm riêng
# GEMINI_THINKING_BUDGET=                # tùy chọn: 0 = tắt suy nghĩ cho nhanh/rẻ (chỉ khi model hỗ trợ)
#
# --- Claude (trả phí) - https://console.anthropic.com -> API Keys ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5       # rẻ + nhanh; muốn chấm kỹ hơn: claude-sonnet-5-5
#
# AI_RATE_LIMIT_PER_HOUR=60              # số lượt gọi AI tối đa / người dùng / giờ (kiểm soát chi phí)

# ============ Chống gian lận tiến độ (xem docs/SRS.md) ============
# STUDY_TICKET_REQUIRED=1            # mặc định BẬT: hoàn thành từ phải kèm "vé phiên học". 0 = tắt (chỉ để tương thích client rất cũ)

# ============ SEED (tùy chọn) ============
# ADMIN_EMAIL=ban@example.com
# ADMIN_PASSWORD=<>=8 ký tự>

# ============ Email (STT 13 - tùy chọn) ============
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                      # 465 = SSL, còn lại dùng STARTTLS
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password        # Gmail: dùng "Mật khẩu ứng dụng", không dùng mật khẩu thường
# SMTP_FROM=Learn Today <your-email@gmail.com>
# Rồi chạy mỗi giờ:  python scripts/send_reminders.py
