# ============ DATABASE (Supabase Postgres) ============
# CÁCH 1 (KHUYÊN DÙNG): khai báo rời. Mật khẩu để NGUYÊN VĂN, kể cả có ký tự đặc biệt như % @ # / ? :
#   Lấy ở Supabase > nút "Connect" > Session pooler (hoặc Transaction pooler).
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432                       # 5432 = Session pooler | 6543 = Transaction pooler
DB_NAME=postgres
DB_USER=postgres.<project-ref>     # với pooler, user luôn có dạng postgres.<project-ref>
DB_PASSWORD=<mật-khẩu-database>

# CÁCH 2: một chuỗi URL (mật khẩu PHẢI mã hóa: % -> %25, @ -> %40, # -> %23, / -> %2F, ? -> %3F, : -> %3A)
# Nếu đặt DB_HOST ở trên thì DATABASE_URL bị bỏ qua.
# DATABASE_URL=postgresql://postgres.<ref>:<mật-khẩu-đã-mã-hóa>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Tinh chỉnh pool (mặc định đã phù hợp gói Free; Session pooler chỉ cho ~15 kết nối)
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=240
# DB_CONNECT_TIMEOUT=10
# DB_SSLMODE=require

# ============ BẢO MẬT ============
# Sinh chuỗi ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<chuỗi-ngẫu-nhiên>
JWT_SECRET=<chuỗi-ngẫu-nhiên-khác-dài-hơn-32-ký-tự>

# ============ SERVER ============
FLASK_APP=run.py
FLASK_DEBUG=1                       # chạy thật: 0
# FLASK_HOST=127.0.0.1
# PORT=5000
# CORS_ORIGINS=http://localhost:5173,https://ten-mien-cua-ban.com
# EXPOSE_ERRORS=0                   # 1 = trả chi tiết lỗi nội bộ về client (CHỈ khi phát triển)

# ============ SEED (tùy chọn) ============
# ADMIN_EMAIL=ban@example.com
# ADMIN_PASSWORD=<>=8 ký tự>

# ============ Email (STT 13 - tùy chọn) ============
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
